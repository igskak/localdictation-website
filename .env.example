# A same-origin absolute HTTPS URL is preferred. The response should set
# Content-Disposition: attachment; filename="Witness.dmg".
DOWNLOAD_URL=

# Optional HTTPS or same-origin endpoint accepting exactly:
# { email, role, languages, usecase? } with stable coded category values.
# Confirm actual key delivery with JSON: { "keyDelivery": "queued" }.
# Cross-origin endpoints must also allow the site's CORS preflight and origin.
LEAD_ENDPOINT=

# Measurement. Leave all three empty and the site loads no tag, shows no
# consent banner, and the privacy policy says so. Set them and section 8 of
# /datenschutz and /en/privacy describes what is loaded — nothing is fetched
# from Google until the reader has agreed in the banner.
GA4_MEASUREMENT_ID=
ADS_CONVERSION_ID=
ADS_LEAD_CONVERSION_LABEL=

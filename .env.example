# A same-origin absolute HTTPS URL is preferred. The response should set
# Content-Disposition: attachment; filename="Witness.dmg".
DOWNLOAD_URL=

# Measurement. Leave all of these empty and the site loads no tag, shows no
# consent banner, and the privacy policy says so. Set them and section 8 of
# /datenschutz and /en/privacy describes what is loaded — nothing is fetched
# from Google until the reader has agreed in the banner.
GA4_MEASUREMENT_ID=
ADS_CONVERSION_ID=
# The one conversion this site reports: the download page was reached. There is
# no lead label because there is no lead -- the key is issued inside the app.
ADS_DOWNLOAD_CONVERSION_LABEL=
